<Application
    x:Class="PrintMeter.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:converters="using:PrintMeter.App.Converters"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Стили объявлены в этом же ResourceDictionary, а не в отдельном файле Source,
       иначе XamlCompiler обрабатывает словарь изолированно и не видит ключи из XamlControlsResources. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>
      <converters:FormatLabelToBrushConverter x:Key="FormatLabelToBrushConverter" />
      <converters:ZeroCountToVisibilityConverter x:Key="ZeroCountToVisibilityConverter" />

      <Style x:Key="SectionCardBorder" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="20" />
      </Style>

      <Style x:Key="ResultsCardBorder" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="0" />
      </Style>

      <Style
          x:Key="SectionTitleText"
          TargetType="TextBlock"
          BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
      </Style>

      <Style
          x:Key="MutedText"
          TargetType="TextBlock"
          BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
      </Style>

      <Style
          x:Key="MutedCaption"
          TargetType="TextBlock"
          BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
      </Style>

      <Style
          x:Key="KpiLabel"
          TargetType="TextBlock"
          BasedOn="{StaticResource MutedCaption}">
        <Setter Property="Margin" Value="0,0,0,4" />
      </Style>

      <Style
          x:Key="IconAccentButton"
          TargetType="Button"
          BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
      </Style>

      <Style
          x:Key="IconDefaultButton"
          TargetType="Button"
          BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
      </Style>

      <Style
          x:Key="ToolbarPrimaryButton"
          TargetType="Button"
          BasedOn="{StaticResource IconAccentButton}">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Margin" Value="0,0,8,8" />
      </Style>

      <Style
          x:Key="ToolbarSecondaryButton"
          TargetType="Button"
          BasedOn="{StaticResource IconDefaultButton}">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Margin" Value="0,0,8,8" />
      </Style>

      <Style x:Key="ToolbarFontIcon" TargetType="FontIcon">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="16" />
      </Style>

      <Style x:Key="SettingsToggle" TargetType="ToggleSwitch">
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="OffContent" Value="Выкл" />
        <Setter Property="OnContent" Value="Вкл" />
      </Style>

      <Style x:Key="SummaryTextBox" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinHeight" Value="88" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
      </Style>

      <Style x:Key="HeroProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="Foreground" Value="{ThemeResource AccentFillColorDefaultBrush}" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
