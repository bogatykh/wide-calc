<Application
    x:Class="PrintMeter.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Стили объявлены в этом же ResourceDictionary, а не в отдельном файле Source,
       иначе XamlCompiler обрабатывает словарь изолированно и не видит ключи из XamlControlsResources. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>

      <Style x:Key="SectionCardBorder" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="20" />
      </Style>

      <Style
          x:Key="ResultsCardBorder"
          TargetType="Border"
          BasedOn="{StaticResource SectionCardBorder}">
        <Setter Property="Padding" Value="0" />
      </Style>

      <Style
          x:Key="PageTagline"
          TargetType="TextBlock"
          BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
        <Setter Property="MaxWidth" Value="560" />
      </Style>

      <Style
          x:Key="SectionTitleText"
          TargetType="TextBlock"
          BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
      </Style>

      <Style
          x:Key="PanelSectionTitle"
          TargetType="TextBlock"
          BasedOn="{StaticResource SectionTitleText}">
        <Setter Property="Margin" Value="16,14,16,8" />
      </Style>

      <Style
          x:Key="MutedText"
          TargetType="TextBlock"
          BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
      </Style>

      <Style x:Key="KpiValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
      </Style>

      <Style
          x:Key="KpiLabel"
          TargetType="TextBlock"
          BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
      </Style>

      <Style
          x:Key="IconAccentButton"
          TargetType="Button"
          BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
      </Style>

      <Style
          x:Key="IconDefaultButton"
          TargetType="Button"
          BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
      </Style>

      <Style
          x:Key="ToolbarPrimaryButton"
          TargetType="Button"
          BasedOn="{StaticResource IconAccentButton}">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Margin" Value="0,0,8,8" />
      </Style>

      <Style
          x:Key="ToolbarSecondaryButton"
          TargetType="Button"
          BasedOn="{StaticResource IconDefaultButton}">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Margin" Value="0,0,8,8" />
      </Style>

      <Style x:Key="FormatChipBorder" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="Margin" Value="0,0,6,6" />
      </Style>

      <Style x:Key="SummaryTextBox" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinHeight" Value="88" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
      </Style>

      <Style x:Key="HeroProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="Foreground" Value="{ThemeResource AccentFillColorDefaultBrush}" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
