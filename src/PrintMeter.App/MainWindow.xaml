<Window
    x:Class="PrintMeter.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="PrintMeter — длина печати по PDF"
    MinWidth="920"
    MinHeight="640"
    mc:Ignorable="d">

  <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
    <Grid
        MaxWidth="1320"
        Padding="28,20,28,24"
        HorizontalAlignment="Stretch">

      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" MinHeight="220" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Шапка страницы -->
      <StackPanel Grid.Row="0">
        <TextBlock
            Margin="0,0,0,10"
            Text="PrintMeter"
            Style="{ThemeResource TitleTextBlockStyle}" />
        <TextBlock
            Margin="0,0,0,10"
            Style="{StaticResource PageTagline}"
            Text="Оценка суммарной длины оттиска по листам PDF с классификацией по форматам ISO. Выберите файлы или папку — результат появится в таблице." />
        <Border
            Height="4"
            Width="56"
            HorizontalAlignment="Left"
            Background="{ThemeResource AccentFillColorDefaultBrush}"
            CornerRadius="2" />
      </StackPanel>

      <!-- Основная зона: панель управления | таблица -->
      <Grid Grid.Row="1" Margin="0,20,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="380" MinWidth="320" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Левая колонка -->
        <ScrollViewer
            Grid.Column="0"
            Margin="0,0,10,0"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <!-- Действия -->
            <Border Style="{StaticResource SectionCardBorder}">
              <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleText}" Text="Действия" />
                <TextBlock
                    Margin="0,0,0,12"
                    Style="{StaticResource MutedText}"
                    Text="Источник данных и запуск расчёта. Экспорт CSV и Excel доступен после анализа."
                    TextWrapping="WrapWholeWords" />

                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Выбор" />
                <StackPanel Margin="0,6,0,0">
                  <Button
                      AutomationProperties.AutomationId="PickPdfFilesButton"
                      AutomationProperties.Name="Выбрать PDF файлы"
                      Command="{Binding PickFilesCommand}"
                      Style="{StaticResource ToolbarPrimaryButton}">
                    <StackPanel Orientation="Horizontal">
                      <FontIcon
                          Margin="0,0,10,0"
                          FontFamily="Segoe MDL2 Assets"
                          FontSize="16"
                          Glyph="&#xE8E5;" />
                      <TextBlock VerticalAlignment="Center" Text="Выбрать PDF…" />
                    </StackPanel>
                  </Button>
                  <Button
                      Margin="0,8,0,0"
                      AutomationProperties.AutomationId="PickFolderButton"
                      AutomationProperties.Name="Выбрать папку"
                      Command="{Binding PickFolderCommand}"
                      Style="{StaticResource ToolbarPrimaryButton}">
                    <StackPanel Orientation="Horizontal">
                      <FontIcon
                          Margin="0,0,10,0"
                          FontFamily="Segoe MDL2 Assets"
                          FontSize="16"
                          Glyph="&#xE8B7;" />
                      <TextBlock VerticalAlignment="Center" Text="Открыть папку…" />
                    </StackPanel>
                  </Button>
                </StackPanel>

                <Border
                    Height="1"
                    Margin="0,10,0,10"
                    Background="{ThemeResource ControlStrokeColorDefaultBrush}"
                    Opacity="0.65" />

                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Расчёт" />
                <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                  <Button
                      AutomationProperties.AutomationId="AnalyzeButton"
                      AutomationProperties.Name="Считать"
                      Command="{Binding AnalyzeCommand}"
                      Style="{StaticResource ToolbarPrimaryButton}">
                    <StackPanel Orientation="Horizontal">
                      <FontIcon
                          Margin="0,0,10,0"
                          FontFamily="Segoe MDL2 Assets"
                          FontSize="16"
                          Glyph="&#xE768;" />
                      <TextBlock VerticalAlignment="Center" Text="Считать" />
                    </StackPanel>
                  </Button>
                  <Button
                      Margin="8,0,0,0"
                      AutomationProperties.AutomationId="CancelButton"
                      AutomationProperties.Name="Отмена действия"
                      Command="{Binding CancelCommand}"
                      Style="{StaticResource ToolbarSecondaryButton}">
                    <StackPanel Orientation="Horizontal">
                      <FontIcon
                          Margin="0,0,10,0"
                          FontFamily="Segoe MDL2 Assets"
                          FontSize="16"
                          Glyph="&#xE711;" />
                      <TextBlock VerticalAlignment="Center" Text="Отмена" />
                    </StackPanel>
                  </Button>
                </StackPanel>

                <Border
                    Height="1"
                    Margin="0,10,0,10"
                    Background="{ThemeResource ControlStrokeColorDefaultBrush}"
                    Opacity="0.65" />

                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Экспорт" />
                <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                  <Button
                      AutomationProperties.AutomationId="ExportCsvButton"
                      AutomationProperties.Name="Экспорт в CSV"
                      Command="{Binding ExportCsvCommand}"
                      Style="{StaticResource ToolbarSecondaryButton}">
                    <StackPanel Orientation="Horizontal">
                      <FontIcon
                          Margin="0,0,10,0"
                          FontFamily="Segoe MDL2 Assets"
                          FontSize="16"
                          Glyph="&#xE8A5;" />
                      <TextBlock VerticalAlignment="Center" Text="CSV…" />
                    </StackPanel>
                  </Button>
                  <Button
                      Margin="8,0,0,0"
                      AutomationProperties.AutomationId="ExportXlsxButton"
                      AutomationProperties.Name="Экспорт в Excel"
                      Command="{Binding ExportXlsxCommand}"
                      Style="{StaticResource ToolbarSecondaryButton}">
                    <StackPanel Orientation="Horizontal">
                      <FontIcon
                          Margin="0,0,10,0"
                          FontFamily="Segoe MDL2 Assets"
                          FontSize="16"
                          Glyph="&#xE9D9;" />
                      <TextBlock VerticalAlignment="Center" Text="XLSX…" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Параметры -->
            <Border Margin="0,16,0,0" Style="{StaticResource SectionCardBorder}">
              <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleText}" Text="Параметры" />
                <ToggleSwitch
                    Margin="0,0,0,8"
                    Header="Искать PDF рекурсивно во вложенных папках"
                    IsOn="{Binding RecursiveFolders, Mode=TwoWay}"
                    OffContent="Выкл"
                    OnContent="Вкл" />
                <ToggleSwitch
                    Header="UTF-8 BOM для CSV (Excel на Windows)"
                    IsOn="{Binding Utf8BomForCsv, Mode=TwoWay}"
                    OffContent="Выкл"
                    OnContent="Вкл" />

                <TextBlock
                    Margin="0,12,0,0"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Допуск по формату" />
                <TextBlock
                    Margin="0,6,0,10"
                    Style="{StaticResource MutedText}"
                    FontSize="12"
                    Text="Включите форматы листов, которые нужно учитывать при сопоставлении размеров страниц."
                    TextWrapping="WrapWholeWords" />

                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource FormatChipBorder}">
                      <CheckBox Content="A4" IsChecked="{Binding FormatA4, Mode=TwoWay}" />
                    </Border>
                    <Border Style="{StaticResource FormatChipBorder}">
                      <CheckBox Content="A3" IsChecked="{Binding FormatA3, Mode=TwoWay}" />
                    </Border>
                    <Border Style="{StaticResource FormatChipBorder}">
                      <CheckBox Content="A2" IsChecked="{Binding FormatA2, Mode=TwoWay}" />
                    </Border>
                    <Border Style="{StaticResource FormatChipBorder}">
                      <CheckBox Content="A1" IsChecked="{Binding FormatA1, Mode=TwoWay}" />
                    </Border>
                  </StackPanel>
                  <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                    <Border Style="{StaticResource FormatChipBorder}">
                      <CheckBox Content="A1+" IsChecked="{Binding FormatA1Plus, Mode=TwoWay}" />
                    </Border>
                    <Border Style="{StaticResource FormatChipBorder}">
                      <CheckBox Content="A0" IsChecked="{Binding FormatA0, Mode=TwoWay}" />
                    </Border>
                    <Border Style="{StaticResource FormatChipBorder}">
                      <CheckBox Content="A0+" IsChecked="{Binding FormatA0Plus, Mode=TwoWay}" />
                    </Border>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Статус -->
            <Border Margin="0,16,0,0" Style="{StaticResource SectionCardBorder}">
              <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleText}" Text="Прогресс" />
                <ProgressBar
                    Margin="0,0,0,8"
                    Maximum="100"
                    Minimum="0"
                    Style="{StaticResource HeroProgress}"
                    Value="{Binding ProgressValue}" />
                <TextBlock
                    Text="{Binding StatusText}"
                    TextWrapping="WrapWholeWords"
                    Style="{ThemeResource BodyTextBlockStyle}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Правая колонка: список результатов (без CommunityToolkit DataGrid — надёжнее для XamlCompiler) -->
        <Border
            Grid.Column="1"
            Margin="10,0,0,0"
            Style="{StaticResource ResultsCardBorder}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock
                Grid.Row="0"
                Style="{StaticResource PanelSectionTitle}"
                Text="Результаты по файлам" />

            <!-- Заголовки «таблицы» -->
            <Grid
                Grid.Row="1"
                Margin="8,0,8,4"
                Padding="8,6"
                Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="160" />
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="88" />
                <ColumnDefinition Width="2*" MinWidth="120" />
                <ColumnDefinition Width="*" MinWidth="80" />
              </Grid.ColumnDefinitions>
              <TextBlock
                  Grid.Column="0"
                  FontWeight="SemiBold"
                  Style="{ThemeResource CaptionTextBlockStyle}"
                  Text="Файл" />
              <TextBlock
                  Grid.Column="1"
                  HorizontalAlignment="Right"
                  FontWeight="SemiBold"
                  Style="{ThemeResource CaptionTextBlockStyle}"
                  Text="Стр." />
              <TextBlock
                  Grid.Column="2"
                  HorizontalAlignment="Right"
                  FontWeight="SemiBold"
                  Style="{ThemeResource CaptionTextBlockStyle}"
                  Text="Длина" />
              <TextBlock
                  Grid.Column="3"
                  FontWeight="SemiBold"
                  Style="{ThemeResource CaptionTextBlockStyle}"
                  Text="По форматам" />
              <TextBlock
                  Grid.Column="4"
                  FontWeight="SemiBold"
                  Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                  Style="{ThemeResource CaptionTextBlockStyle}"
                  Text="Ошибка" />
            </Grid>

            <ListView
                Grid.Row="2"
                x:Name="ResultsList"
                Margin="8,0,8,8"
                HorizontalContentAlignment="Stretch"
                IsItemClickEnabled="False"
                IsSwipeEnabled="False"
                ItemsSource="{Binding Rows}"
                SelectionMode="Single"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollBarVisibility="Auto">
              <ListView.ItemTemplate>
                <DataTemplate>
                  <Grid Padding="8,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="2*" MinWidth="160" />
                      <ColumnDefinition Width="64" />
                      <ColumnDefinition Width="88" />
                      <ColumnDefinition Width="2*" MinWidth="120" />
                      <ColumnDefinition Width="*" MinWidth="80" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{Binding FilePath}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Text="{Binding PageCount}" />
                    <TextBlock
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Text="{Binding TotalLengthMeters}" />
                    <TextBlock
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        MaxLines="2"
                        Text="{Binding FormatsSummary}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        Grid.Column="4"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        MaxLines="2"
                        Text="{Binding Error}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="WrapWholeWords" />
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
          </Grid>
        </Border>
      </Grid>

      <!-- Низ: KPI + сводка -->
      <Border
          Grid.Row="2"
          Margin="0,20,0,0"
          Style="{StaticResource SectionCardBorder}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" MinWidth="280" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0">
            <TextBlock Style="{StaticResource KpiLabel}" Text="Всего (метры)" />
            <TextBlock Style="{StaticResource KpiValue}" Text="{Binding TotalLengthMeters, Mode=OneWay}" />
          </StackPanel>

          <StackPanel Grid.Column="1" Margin="24,0,0,0">
            <TextBlock Style="{StaticResource SectionTitleText}" Text="Сводка по форматам" />
            <TextBox
                Margin="0,4,0,0"
                Style="{StaticResource SummaryTextBox}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                Text="{Binding SummaryByFormat, Mode=OneWay}" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
