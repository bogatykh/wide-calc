<Window
    x:Class="PrintMeter.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="PrintMeter — метраж печати по PDF"
    MinWidth="920"
    MinHeight="640"
    mc:Ignorable="d">

  <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
    <Grid
        x:Name="RootGrid"
        MaxWidth="1320"
        Padding="28,20,28,24"
        HorizontalAlignment="Stretch">

      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" MinHeight="220" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0">
        <TextBlock
            Margin="0,0,0,10"
            Text="PrintMeter"
            Style="{ThemeResource TitleTextBlockStyle}" />
        <TextBlock
            Margin="0,0,0,10"
            Style="{StaticResource PageTagline}"
            Text="Каждый выбор PDF добавляет файлы к общему списку и дополняет таблицу (дубликаты путей пропускаются). Новый выбор папки обновляет набор PDF из этой папки, остальные добавленные вручную файлы сохраняются. «Считать заново» очищает таблицу и пересчитывает весь список. Метраж — по длинной стороне листа. «Очистить» сбрасывает всё." />
        <Border
            Height="4"
            Width="56"
            HorizontalAlignment="Left"
            Background="{ThemeResource AccentFillColorDefaultBrush}"
            CornerRadius="2" />
      </StackPanel>

      <Grid Grid.Row="1" Margin="0,20,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="380" MinWidth="320" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer
            Grid.Column="0"
            Margin="0,0,10,0"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <Border Style="{StaticResource SectionCardBorder}">
              <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleText}" Text="Действия" />
                <TextBlock
                    Margin="0,0,0,12"
                    Style="{StaticResource MutedText}"
                    Text="Источник данных и экспорт CSV/XLSX (после расчёта)."
                    TextWrapping="WrapWholeWords" />

                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Выбор" />
                <StackPanel Margin="0,6,0,0">
                  <Button
                      AutomationProperties.AutomationId="PickPdfFilesButton"
                      Command="{Binding PickFilesCommand}"
                      Style="{StaticResource ToolbarPrimaryButton}">
                    <StackPanel Orientation="Horizontal">
                      <FontIcon Margin="0,0,10,0" FontFamily="Segoe MDL2 Assets" FontSize="16" Glyph="&#xE8E5;" />
                      <TextBlock VerticalAlignment="Center" Text="Выбрать PDF…" />
                    </StackPanel>
                  </Button>
                  <Button
                      Margin="0,8,0,0"
                      AutomationProperties.AutomationId="PickFolderButton"
                      Command="{Binding PickFolderCommand}"
                      Style="{StaticResource ToolbarPrimaryButton}">
                    <StackPanel Orientation="Horizontal">
                      <FontIcon Margin="0,0,10,0" FontFamily="Segoe MDL2 Assets" FontSize="16" Glyph="&#xE8B7;" />
                      <TextBlock VerticalAlignment="Center" Text="Открыть папку…" />
                    </StackPanel>
                  </Button>
                  <Button
                      Margin="0,8,0,0"
                      AutomationProperties.AutomationId="ClearAllButton"
                      Command="{Binding ClearAllCommand}"
                      Style="{StaticResource ToolbarSecondaryButton}"
                      ToolTipService.ToolTip="Удалить выбранные файлы и очистить таблицу с результатами">
                    <StackPanel Orientation="Horizontal">
                      <FontIcon Margin="0,0,10,0" FontFamily="Segoe MDL2 Assets" FontSize="16" Glyph="&#xE894;" />
                      <TextBlock VerticalAlignment="Center" Text="Очистить" />
                    </StackPanel>
                  </Button>
                </StackPanel>

                <Border
                    Height="1"
                    Margin="0,10,0,10"
                    Background="{ThemeResource ControlStrokeColorDefaultBrush}"
                    Opacity="0.65" />

                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Расчёт" />
                <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                  <Button
                      AutomationProperties.AutomationId="AnalyzeButton"
                      Command="{Binding AnalyzeCommand}"
                      Style="{StaticResource ToolbarPrimaryButton}"
                      ToolTipService.ToolTip="Пересчитать текущий набор PDF без повторного выбора в диалоге">
                    <StackPanel Orientation="Horizontal">
                      <FontIcon Margin="0,0,10,0" FontFamily="Segoe MDL2 Assets" FontSize="16" Glyph="&#xE768;" />
                      <TextBlock VerticalAlignment="Center" Text="Считать заново" />
                    </StackPanel>
                  </Button>
                  <Button
                      Margin="8,0,0,0"
                      AutomationProperties.AutomationId="CancelButton"
                      Command="{Binding CancelCommand}"
                      Style="{StaticResource ToolbarSecondaryButton}">
                    <StackPanel Orientation="Horizontal">
                      <FontIcon Margin="0,0,10,0" FontFamily="Segoe MDL2 Assets" FontSize="16" Glyph="&#xE711;" />
                      <TextBlock VerticalAlignment="Center" Text="Отмена" />
                    </StackPanel>
                  </Button>
                </StackPanel>

                <Border
                    Height="1"
                    Margin="0,10,0,10"
                    Background="{ThemeResource ControlStrokeColorDefaultBrush}"
                    Opacity="0.65" />

                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Экспорт" />
                <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                  <Button
                      AutomationProperties.AutomationId="ExportCsvButton"
                      Command="{Binding ExportCsvCommand}"
                      Style="{StaticResource ToolbarSecondaryButton}">
                    <StackPanel Orientation="Horizontal">
                      <FontIcon Margin="0,0,10,0" FontFamily="Segoe MDL2 Assets" FontSize="16" Glyph="&#xE8A5;" />
                      <TextBlock VerticalAlignment="Center" Text="CSV…" />
                    </StackPanel>
                  </Button>
                  <Button
                      Margin="8,0,0,0"
                      AutomationProperties.AutomationId="ExportXlsxButton"
                      Command="{Binding ExportXlsxCommand}"
                      Style="{StaticResource ToolbarSecondaryButton}">
                    <StackPanel Orientation="Horizontal">
                      <FontIcon Margin="0,0,10,0" FontFamily="Segoe MDL2 Assets" FontSize="16" Glyph="&#xE9D9;" />
                      <TextBlock VerticalAlignment="Center" Text="XLSX…" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Margin="0,16,0,0" Style="{StaticResource SectionCardBorder}">
              <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleText}" Text="Форматы и сводка по расчёту" />
                <ToggleSwitch
                    Margin="0,0,0,12"
                    Header="Искать PDF рекурсивно во вложенных папках"
                    IsOn="{Binding RecursiveFolders, Mode=TwoWay}"
                    OffContent="Выкл"
                    OnContent="Вкл"
                    ToolTipService.ToolTip="Если последний выбор был папкой, переключение обновляет список PDF из той же папки и снова запускает расчёт." />
                <ToggleSwitch
                    Margin="0,0,0,12"
                    Header="UTF-8 BOM для CSV (Excel в RU-локали)"
                    IsOn="{Binding Utf8BomForCsv, Mode=TwoWay}"
                    OffContent="Выкл"
                    OnContent="Вкл" />

                <TextBlock
                    Margin="0,0,0,8"
                    Style="{StaticResource MutedText}"
                    FontSize="12"
                    Text="Снимите формат, чтобы помечать такие страницы как пользовательские (Custom …). Справа — число листов и суммарные метры по длинной стороне только для включённых в расчёт ISO-меток."
                    TextWrapping="WrapWholeWords" />

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <CheckBox
                      Grid.Row="0"
                      Grid.Column="0"
                      Margin="0,0,12,8"
                      VerticalAlignment="Center"
                      Content="A4"
                      IsChecked="{Binding FormatA4, Mode=TwoWay}" />
                  <TextBlock
                      Grid.Row="0"
                      Grid.Column="1"
                      Margin="0,0,0,8"
                      VerticalAlignment="Center"
                      Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                      Text="{Binding FormatStatA4}" />

                  <CheckBox
                      Grid.Row="1"
                      Grid.Column="0"
                      Margin="0,0,12,8"
                      VerticalAlignment="Center"
                      Content="A3"
                      IsChecked="{Binding FormatA3, Mode=TwoWay}" />
                  <TextBlock
                      Grid.Row="1"
                      Grid.Column="1"
                      Margin="0,0,0,8"
                      VerticalAlignment="Center"
                      Text="{Binding FormatStatA3}" />

                  <CheckBox
                      Grid.Row="2"
                      Grid.Column="0"
                      Margin="0,0,12,8"
                      VerticalAlignment="Center"
                      Content="A2"
                      IsChecked="{Binding FormatA2, Mode=TwoWay}" />
                  <TextBlock
                      Grid.Row="2"
                      Grid.Column="1"
                      Margin="0,0,0,8"
                      VerticalAlignment="Center"
                      Text="{Binding FormatStatA2}" />

                  <CheckBox
                      Grid.Row="3"
                      Grid.Column="0"
                      Margin="0,0,12,8"
                      VerticalAlignment="Center"
                      Content="A1"
                      IsChecked="{Binding FormatA1, Mode=TwoWay}"
                      ToolTipService.ToolTip="Короткая сторона до 610 mm (все бывшие A1+ считаются как A1)." />
                  <TextBlock
                      Grid.Row="3"
                      Grid.Column="1"
                      Margin="0,0,0,8"
                      VerticalAlignment="Center"
                      Text="{Binding FormatStatA1}" />

                  <CheckBox
                      Grid.Row="4"
                      Grid.Column="0"
                      Margin="0,0,12,0"
                      VerticalAlignment="Center"
                      Content="A0"
                      IsChecked="{Binding FormatA0, Mode=TwoWay}"
                      ToolTipService.ToolTip="Короткая сторона до 914 mm (все бывшие A0+ считаются как A0)." />
                  <TextBlock Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" Text="{Binding FormatStatA0}" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Margin="0,16,0,0" Style="{StaticResource SectionCardBorder}">
              <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleText}" Text="Прогресс" />
                <TextBlock
                    Margin="0,0,0,8"
                    Text="{Binding StatusText}"
                    TextWrapping="WrapWholeWords"
                    Style="{ThemeResource BodyTextBlockStyle}" />
                <ProgressBar
                    Margin="0,0,0,8"
                    Maximum="100"
                    Minimum="0"
                    Style="{StaticResource HeroProgress}"
                    Value="{Binding ProgressValue}" />
                <TextBlock
                    Margin="0,0,0,6"
                    FontWeight="SemiBold"
                    Text="{Binding TotalLengthMeters, StringFormat='Всего по длинной стороне листов, м: {}{0:F3}'}"
                    Style="{ThemeResource BodyTextBlockStyle}" />
                <TextBlock
                    Text="{Binding BillingPricelistFormatsSummary}"
                    TextWrapping="WrapWholeWords"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource BodyTextBlockStyle}"
                    ToolTipService.ToolTip="По каждой ISO-метке в сводке: сумма мм по длинной стороне делится на номинал из справочника в коде." />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource ResultsCardBorder}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock
                Grid.Row="0"
                Style="{StaticResource PanelSectionTitle}"
                Text="Результаты по файлам" />

            <ListView
                Grid.Row="1"
                x:Name="ResultsListView"
                Margin="8,0,8,8"
                Padding="4"
                HorizontalScrollBarVisibility="Auto"
                ItemsSource="{Binding Rows}"
                SelectionMode="Single"
                VerticalScrollBarVisibility="Auto">
              <ListView.View>
                <GridView>
                  <GridViewColumn
                      Width="280"
                      DisplayMemberBinding="{Binding FilePath}"
                      Header="Файл" />
                  <GridViewColumn
                      Width="72"
                      DisplayMemberBinding="{Binding PageCount}"
                      Header="Листов" />
                  <GridViewColumn
                      Width="100"
                      DisplayMemberBinding="{Binding TotalLengthMeters}"
                      Header="Длина, м" />
                  <GridViewColumn
                      Width="220"
                      DisplayMemberBinding="{Binding FormatsSummary}"
                      Header="По форматам" />
                  <GridViewColumn
                      Width="140"
                      DisplayMemberBinding="{Binding Path=Error}"
                      Header="Ошибка" />
                </GridView>
              </ListView.View>
            </ListView>
          </Grid>
        </Border>
      </Grid>

      <Border Grid.Row="2" Margin="0,20,0,0" Style="{StaticResource SectionCardBorder}">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionTitleText}" Text="Текстовая сводка по форматам" />
          <TextBox
              Margin="0,4,0,0"
              Style="{StaticResource SummaryTextBox}"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              ScrollViewer.VerticalScrollBarVisibility="Auto"
              Text="{Binding SummaryByFormat, Mode=OneWay}" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
