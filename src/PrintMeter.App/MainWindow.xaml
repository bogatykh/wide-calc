<Window
    x:Class="PrintMeter.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PrintMeter — метраж печати по PDF">

  <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
    <Grid
        x:Name="RootGrid"
        MaxWidth="1480"
        MinWidth="1260"
        MinHeight="780"
        Padding="24,18,24,20"
        HorizontalAlignment="Stretch">

      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource SectionCardBorder}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Spacing="6">
            <TextBlock
                Text="PrintMeter"
                Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock
                Style="{StaticResource MutedText}"
                Text="Windows-ориентированная рабочая панель для пакетного анализа PDF: быстрый выбор источника, прозрачный прогресс и детальные результаты по каждому файлу."
                TextWrapping="WrapWholeWords" />
            <TextBlock
                Style="{StaticResource MutedCaption}"
                Text="Горячие клавиши: Ctrl+O (PDF), Ctrl+Shift+O (папка), F5 (пересчёт), Esc (отмена), Ctrl+E (CSV), Ctrl+Shift+E (XLSX)."
                TextWrapping="WrapWholeWords" />
          </StackPanel>

          <StackPanel
              Grid.Column="1"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Orientation="Horizontal"
              Spacing="8">
            <Button
                AutomationProperties.AutomationId="PickPdfFilesButton"
                Command="{Binding PickFilesCommand}"
                Style="{StaticResource ToolbarPrimaryButton}">
              <Button.KeyboardAccelerators>
                <KeyboardAccelerator Key="O" Modifiers="Control" />
              </Button.KeyboardAccelerators>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Style="{StaticResource ToolbarFontIcon}" Glyph="&#xE8E5;" />
                <TextBlock VerticalAlignment="Center" Text="Выбрать PDF…" />
              </StackPanel>
            </Button>
            <Button
                AutomationProperties.AutomationId="PickFolderButton"
                Command="{Binding PickFolderCommand}"
                Style="{StaticResource ToolbarSecondaryButton}">
              <Button.KeyboardAccelerators>
                <KeyboardAccelerator Key="O" Modifiers="Control,Shift" />
              </Button.KeyboardAccelerators>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Style="{StaticResource ToolbarFontIcon}" Glyph="&#xE8B7;" />
                <TextBlock VerticalAlignment="Center" Text="Открыть папку…" />
              </StackPanel>
            </Button>
            <Button
                AutomationProperties.AutomationId="AnalyzeButton"
                Command="{Binding AnalyzeCommand}"
                Style="{StaticResource ToolbarPrimaryButton}"
                ToolTipService.ToolTip="Пересчитать текущий набор PDF без повторного выбора в диалоге">
              <Button.KeyboardAccelerators>
                <KeyboardAccelerator Key="F5" />
              </Button.KeyboardAccelerators>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Style="{StaticResource ToolbarFontIcon}" Glyph="&#xE768;" />
                <TextBlock VerticalAlignment="Center" Text="Считать заново" />
              </StackPanel>
            </Button>
            <Button
                AutomationProperties.AutomationId="CancelButton"
                Command="{Binding CancelCommand}"
                Style="{StaticResource ToolbarSecondaryButton}">
              <Button.KeyboardAccelerators>
                <KeyboardAccelerator Key="Escape" />
              </Button.KeyboardAccelerators>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Style="{StaticResource ToolbarFontIcon}" Glyph="&#xE711;" />
                <TextBlock VerticalAlignment="Center" Text="Отмена" />
              </StackPanel>
            </Button>
            <Button
                AutomationProperties.AutomationId="ClearAllButton"
                Command="{Binding ClearAllCommand}"
                Style="{StaticResource ToolbarSecondaryButton}"
                ToolTipService.ToolTip="Удалить выбранные файлы и очистить таблицу с результатами">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Style="{StaticResource ToolbarFontIcon}" Glyph="&#xE894;" />
                <TextBlock VerticalAlignment="Center" Text="Очистить" />
              </StackPanel>
            </Button>
            <Border
                Width="1"
                Height="26"
                Margin="2,0"
                VerticalAlignment="Center"
                Background="{ThemeResource ControlStrokeColorDefaultBrush}"
                Opacity="0.7" />
            <Button
                AutomationProperties.AutomationId="ExportCsvButton"
                Command="{Binding ExportCsvCommand}"
                Style="{StaticResource ToolbarSecondaryButton}">
              <Button.KeyboardAccelerators>
                <KeyboardAccelerator Key="E" Modifiers="Control" />
              </Button.KeyboardAccelerators>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Style="{StaticResource ToolbarFontIcon}" Glyph="&#xE8A5;" />
                <TextBlock VerticalAlignment="Center" Text="CSV…" />
              </StackPanel>
            </Button>
            <Button
                AutomationProperties.AutomationId="ExportXlsxButton"
                Command="{Binding ExportXlsxCommand}"
                Style="{StaticResource ToolbarSecondaryButton}">
              <Button.KeyboardAccelerators>
                <KeyboardAccelerator Key="E" Modifiers="Control,Shift" />
              </Button.KeyboardAccelerators>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Style="{StaticResource ToolbarFontIcon}" Glyph="&#xE9D9;" />
                <TextBlock VerticalAlignment="Center" Text="XLSX…" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1" Margin="0,14,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.3*" />
          <ColumnDefinition Width="1.2*" />
          <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Margin="0,0,10,0" Style="{StaticResource SectionCardBorder}">
          <StackPanel>
            <TextBlock Style="{StaticResource KpiLabel}" Text="Текущий статус" />
            <TextBlock
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                Text="{Binding StatusText}"
                TextWrapping="WrapWholeWords" />
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Margin="0,0,10,0" Style="{StaticResource SectionCardBorder}">
          <StackPanel>
            <TextBlock Style="{StaticResource KpiLabel}" Text="Суммарная длина" />
            <TextBlock Style="{StaticResource KpiValue}" Text="{Binding TotalLengthMetersSummaryText}" />
            <ProgressBar
                Margin="0,8,0,0"
                Maximum="100"
                Minimum="0"
                Style="{StaticResource HeroProgress}"
                Value="{Binding ProgressValue}" />
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource SectionCardBorder}">
          <StackPanel>
            <TextBlock Style="{StaticResource KpiLabel}" Text="Прайс-сводка по ISO форматам" />
            <TextBlock
                Style="{StaticResource MutedText}"
                Text="{Binding BillingPricelistFormatsSummary}"
                TextWrapping="WrapWholeWords"
                ToolTipService.ToolTip="По каждой ISO-метке в сводке: сумма мм по длинной стороне делится на номинал из справочника в коде." />
          </StackPanel>
        </Border>
      </Grid>

      <Grid Grid.Row="2" Margin="0,14,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="360" MinWidth="330" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer
            Grid.Column="0"
            Margin="0,0,10,0"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <Border Style="{StaticResource SectionCardBorder}">
              <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleText}" Text="Настройки расчёта" />
                <ToggleSwitch
                    Style="{StaticResource SettingsToggle}"
                    Header="Рекурсивный поиск PDF во вложенных папках"
                    IsOn="{Binding RecursiveFolders, Mode=TwoWay}"
                    ToolTipService.ToolTip="Если последний выбор был папкой, переключение обновляет список PDF из той же папки и снова запускает расчёт." />
                <ToggleSwitch
                    Style="{StaticResource SettingsToggle}"
                    Header="UTF-8 BOM для CSV (Excel в RU-локали)"
                    IsOn="{Binding Utf8BomForCsv, Mode=TwoWay}" />

                <TextBlock
                    Margin="0,0,0,8"
                    Style="{StaticResource MutedText}"
                    FontSize="12"
                    Text="Снимите формат, чтобы отмечать его как Custom. В сводке справа учитываются только включённые ISO-метки."
                    TextWrapping="WrapWholeWords" />

                <ItemsControl ItemsSource="{Binding FormatRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,0,0,8" ToolTipService.ToolTip="{Binding Tooltip}">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Grid.Column="0"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource ToolbarFontIcon}"
                            FontSize="{Binding IconSize}"
                            Foreground="{Binding Label, Converter={StaticResource FormatLabelToBrushConverter}}"
                            Glyph="&#xE8A5;" />
                        <CheckBox
                            Grid.Column="1"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Content="{Binding Label}"
                            IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Text="{Binding StatText}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>

        <Grid Grid.Column="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Style="{StaticResource ResultsCardBorder}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <Grid Grid.Row="0" Margin="16,14,16,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Style="{StaticResource SectionTitleText}"
                    Text="Результаты по файлам" />
                <ProgressRing
                    Grid.Column="1"
                    Width="20"
                    Height="20"
                    Margin="0,0,8,0"
                    IsActive="{Binding IsBusy}" />
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Style="{StaticResource MutedCaption}"
                    Text="{Binding ProgressPercentText}" />
              </Grid>

              <Grid Grid.Row="1" Margin="8,0,8,8">
                <Grid>
                  <controls:DataGrid
                      x:Name="ResultsDataGrid"
                      AlternatingRowBackground="{ThemeResource ControlAltFillColorSecondaryBrush}"
                      AutoGenerateColumns="False"
                      CanUserReorderColumns="False"
                      CanUserResizeColumns="True"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="All"
                      IsReadOnly="True"
                      ItemsSource="{Binding Rows}"
                      MinColumnWidth="72"
                      RowBackground="{ThemeResource ControlAltFillColorTertiaryBrush}"
                      SelectionMode="Single">
                    <controls:DataGrid.Columns>
                      <controls:DataGridTextColumn Width="2*" Binding="{Binding FilePath}" Header="Файл" />
                      <controls:DataGridTextColumn Width="96" Binding="{Binding PageCount}" Header="Листов" />
                      <controls:DataGridTextColumn Width="132" Binding="{Binding TotalLengthMeters}" Header="Длина, м" />
                      <controls:DataGridTextColumn Width="2*" Binding="{Binding FormatsSummary}" Header="По форматам" />
                      <controls:DataGridTextColumn Width="2*" Binding="{Binding IssueText}" Header="Ошибка" />
                    </controls:DataGrid.Columns>
                  </controls:DataGrid>

                  <Border
                      MaxWidth="560"
                      Padding="18,14"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                      BorderThickness="1"
                      CornerRadius="10"
                      Visibility="{Binding Rows.Count, Converter={StaticResource ZeroCountToVisibilityConverter}}">
                    <StackPanel Spacing="8">
                      <FontIcon
                          HorizontalAlignment="Center"
                          FontFamily="Segoe MDL2 Assets"
                          FontSize="28"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                          Glyph="&#xE8A5;" />
                      <TextBlock
                          Style="{ThemeResource BodyStrongTextBlockStyle}"
                          Text="Пока нет данных для отображения"
                          TextAlignment="Center" />
                      <TextBlock
                          Style="{StaticResource MutedText}"
                          Text="Нажмите «Выбрать PDF…» или «Открыть папку…». После анализа результаты появятся в этой таблице."
                          TextAlignment="Center"
                          TextWrapping="WrapWholeWords" />
                      <StackPanel
                          HorizontalAlignment="Center"
                          Orientation="Horizontal"
                          Spacing="8">
                        <Button
                            Command="{Binding PickFilesCommand}"
                            Style="{StaticResource ToolbarPrimaryButton}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Style="{StaticResource ToolbarFontIcon}" FontSize="14" Glyph="&#xE8E5;" />
                            <TextBlock Text="Выбрать PDF…" />
                          </StackPanel>
                        </Button>
                        <Button
                            Command="{Binding PickFolderCommand}"
                            Style="{StaticResource ToolbarSecondaryButton}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Style="{StaticResource ToolbarFontIcon}" FontSize="14" Glyph="&#xE8B7;" />
                            <TextBlock Text="Открыть папку…" />
                          </StackPanel>
                        </Button>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </Grid>
              </Grid>
            </Grid>
          </Border>

          <Border Grid.Row="1" Margin="0,10,0,0" Style="{StaticResource SectionCardBorder}">
            <StackPanel>
              <TextBlock Style="{StaticResource SectionTitleText}" Text="Текстовая сводка по форматам" />
              <TextBox
                  Margin="0,4,0,0"
                  Style="{StaticResource SummaryTextBox}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  Text="{Binding SummaryByFormat, Mode=OneWay}" />
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
