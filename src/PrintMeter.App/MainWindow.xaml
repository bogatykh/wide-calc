<Window x:Class="PrintMeter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PrintMeter — метраж печати по PDF"
        Height="760"
        Width="1120"
        MinWidth="920"
        MinHeight="560"
        WindowStartupLocation="CenterScreen">
  <DockPanel Margin="16">
    <!-- Верх: действия и параметры -->
    <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Orientation="Vertical">
        <TextBlock TextWrapping="Wrap" Foreground="#444" FontSize="13" Margin="0,0,0,12"
                   Text="При новом выборе PDF или папки список файлов заменяется, таблица очищается и расчёт запускается автоматически. Метраж по каждому листу берётся по длинной стороне страницы (вертикальная или горизонтальная ориентация не меняет итог). «Очистить» обнуляет выбор и результаты." />

        <!-- Файлы и расчёт -->
        <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10" Background="#FAFAFA">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Margin="0,0,0,8" Text="Файлы и расчёт" />
            <WrapPanel ItemHeight="36" Margin="0,0,0,6">
              <Button Content="Выбрать PDF…" Command="{Binding PickFilesCommand}" MinWidth="120" Margin="0,0,8,6" Padding="12,8" />
              <Button Content="Выбрать папку…" Command="{Binding PickFolderCommand}" MinWidth="128" Margin="0,0,8,6" Padding="12,8" />
              <Button Content="Очистить"
                      Command="{Binding ClearAllCommand}"
                      MinWidth="100"
                      Margin="0,0,16,6"
                      Padding="12,8"
                      ToolTip="Удалить выбранные файлы и очистить таблицу с результатами" />
              <Button Content="Считать заново"
                      Command="{Binding AnalyzeCommand}"
                      MinWidth="120"
                      Margin="0,0,8,6"
                      Padding="12,8"
                      FontWeight="SemiBold"
                      ToolTip="Пересчитать текущий набор PDF без повторного выбора в диалоге" />
              <Button Content="Отмена" Command="{Binding CancelCommand}" MinWidth="88" Margin="0,0,8,6" Padding="12,8" />
            </WrapPanel>
            <WrapPanel ItemHeight="32">
              <Button Content="Экспорт CSV" Command="{Binding ExportCsvCommand}" MinWidth="110" Margin="0,0,8,6" Padding="10,6" />
              <Button Content="Экспорт XLSX" Command="{Binding ExportXlsxCommand}" MinWidth="110" Margin="0,0,8,6" Padding="10,6" />
            </WrapPanel>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <CheckBox Content="Рекурсивно искать PDF в папке"
                        IsChecked="{Binding RecursiveFolders}"
                        VerticalAlignment="Center"
                        Margin="0,0,20,0"
                        ToolTip="Если последний выбор был папкой, переключение обновляет список PDF из той же папки и снова запускает расчёт." />
              <CheckBox Content="UTF-8 BOM для CSV (Excel в RU-локали)"
                        IsChecked="{Binding Utf8BomForCsv}"
                        VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Форматы -->
        <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10" Background="#FAFAFA">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Margin="0,0,0,6" Text="Учитываемые форматы ISO и сводка по последнему расчёту" />
            <TextBlock TextWrapping="Wrap"
                       Foreground="#555"
                       FontSize="12"
                       Margin="0,0,0,8"
                       Text="Снимите формат, чтобы помечать такие страницы как пользовательские (Custom …). Справа — число листов и суммарные метры по длинной стороне только для включённых в расчёт ISO-меток." />

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="120" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <CheckBox Grid.Row="0" Grid.Column="0" Content="A4" IsChecked="{Binding FormatA4}" VerticalAlignment="Center" Margin="0,0,12,8" />
              <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FormatStatA4}" VerticalAlignment="Center" Margin="0,0,0,8" Foreground="#333" />

              <CheckBox Grid.Row="1" Grid.Column="0" Content="A3" IsChecked="{Binding FormatA3}" VerticalAlignment="Center" Margin="0,0,12,8" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FormatStatA3}" VerticalAlignment="Center" Margin="0,0,0,8" Foreground="#333" />

              <CheckBox Grid.Row="2" Grid.Column="0" Content="A2" IsChecked="{Binding FormatA2}" VerticalAlignment="Center" Margin="0,0,12,8" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FormatStatA2}" VerticalAlignment="Center" Margin="0,0,0,8" Foreground="#333" />

              <CheckBox Grid.Row="3" Grid.Column="0" Content="A1" IsChecked="{Binding FormatA1}" VerticalAlignment="Center" Margin="0,0,12,8" />
              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding FormatStatA1}" VerticalAlignment="Center" Margin="0,0,0,8" Foreground="#333" />

              <CheckBox Grid.Row="4" Grid.Column="0" Content="A1+" IsChecked="{Binding FormatA1Plus}" VerticalAlignment="Center" Margin="0,0,12,8" />
              <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding FormatStatA1Plus}" VerticalAlignment="Center" Margin="0,0,0,8" Foreground="#333" />

              <CheckBox Grid.Row="5" Grid.Column="0" Content="A0" IsChecked="{Binding FormatA0}" VerticalAlignment="Center" Margin="0,0,12,8" />
              <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding FormatStatA0}" VerticalAlignment="Center" Margin="0,0,0,8" Foreground="#333" />

              <CheckBox Grid.Row="6" Grid.Column="0" Content="A0+" IsChecked="{Binding FormatA0Plus}" VerticalAlignment="Center" Margin="0,0,12,0" />
              <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding FormatStatA0Plus}" VerticalAlignment="Center" Foreground="#333" />
            </Grid>
          </StackPanel>
        </Border>

        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,6" />
        <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" FontSize="14" Text="{Binding TotalLengthMeters, StringFormat='Всего по длинной стороне листов, м: {0:F3}'}" />
        <ProgressBar Height="14" Margin="0,0,0,0" Minimum="0" Maximum="100" Value="{Binding ProgressValue}" />
      </StackPanel>
    </ScrollViewer>

    <!-- Низ: текстовая сводка -->
    <Border DockPanel.Dock="Bottom" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,12,0,0" Background="#FAFAFA" Height="128">
      <DockPanel LastChildFill="True">
        <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Text="Текстовая сводка по форматам" Margin="0,0,0,6" />
        <TextBox Text="{Binding SummaryByFormat}"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 BorderThickness="0"
                 Background="Transparent"
                 FontFamily="Consolas,Courier New"
                 Padding="4" />
      </DockPanel>
    </Border>

    <!-- Центр: таблица -->
    <DataGrid ItemsSource="{Binding Rows}"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserAddRows="False"
              EnableRowVirtualization="True"
              EnableColumnVirtualization="True"
              HeadersVisibility="Column"
              GridLinesVisibility="Horizontal"
              AlternatingRowBackground="#F9F9F9">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Файл"
                            Binding="{Binding FilePath}"
                            Width="*" />
        <DataGridTextColumn Header="Листов (стр.)"
                            Binding="{Binding PageCount}"
                            Width="100" />
        <DataGridTextColumn Header="Длина, м (max стороны)"
                            Binding="{Binding TotalLengthMeters}"
                            Width="148" />
        <DataGridTextColumn Header="По форматам (метры)"
                            Binding="{Binding FormatsSummary}"
                            Width="2*" />
        <DataGridTextColumn Header="Ошибка"
                            Binding="{Binding Error}"
                            Width="*" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
