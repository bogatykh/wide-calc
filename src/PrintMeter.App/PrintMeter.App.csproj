<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>PrintMeter.App</RootNamespace>
    <AssemblyName>PrintMeter</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWinUI>true</UseWinUI>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <WindowsAppSDKSelfContained Condition="'$(WindowsAppSDKSelfContained)' == ''">false</WindowsAppSDKSelfContained>
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <WindowsAppSdkIncludeVersionInfo>true</WindowsAppSdkIncludeVersionInfo>
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
    <UseXamlCompilerExecutable>false</UseXamlCompilerExecutable>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <WindowsSdkPackageVersion>10.0.22621.56</WindowsSdkPackageVersion>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <StartupObject>PrintMeter.App.Program</StartupObject>
    <CopyBuildOutputToPublishDirectory>true</CopyBuildOutputToPublishDirectory>
    <EnablePriGenTooling>true</EnablePriGenTooling>
    <!-- Явно: иначе CalculateAppxGenerateProjectPriEnabled может оставить false и проектный PRI не соберётся. -->
    <AppxGeneratePriEnabled>true</AppxGeneratePriEnabled>
  </PropertyGroup>

  <PropertyGroup Condition="'$(WindowsAppSDKSelfContained)' == 'true'">
    <DefineConstants>$(DefineConstants);PRINTMETER_WINDOWS_APPSDK_SELF_CONTAINED</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.WinUI" Version="7.1.2" />
    <PackageReference Include="CommunityToolkit.WinUI.UI.Controls.DataGrid" Version="7.1.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.7" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250602001" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PrintMeter.App.ViewModels\PrintMeter.App.ViewModels.csproj" />
    <ProjectReference Include="..\PrintMeter.Core\PrintMeter.Core.csproj" />
    <ProjectReference Include="..\PrintMeter.Pdf\PrintMeter.Pdf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    Публикация .NET по умолчанию не всегда подхватывает project PRI; без него LoadComponent падает.
    PrepareForRun тянет _GenerateProjectPriFile (MRT): PRI оказывается в $(TargetDir) как PrintMeter.pri или resources.pri.
  -->
  <Target Name="_PrintMeterAddAppPriToResolvedPublish"
          BeforeTargets="ComputeResolvedFilesToPublishList"
          DependsOnTargets="PrepareForRun">
    <ItemGroup>
      <_AppPriForPublish Include="$(TargetDir)PrintMeter.pri" Condition="Exists('$(TargetDir)PrintMeter.pri')" />
      <_AppPriForPublish Include="$(TargetDir)resources.pri" Condition="Exists('$(TargetDir)resources.pri')" />
    </ItemGroup>
    <Error
        Text="PrintMeter: нет PrintMeter.pri и resources.pri в $(TargetDir) после PrepareForRun — MRT/PRI не сгенерировался (MakePri, AppxGeneratePriEnabled, XAML items)."
        Condition="'@(_AppPriForPublish)' == ''" />
    <ItemGroup>
      <ResolvedFileToPublish Include="@(_AppPriForPublish)">
        <RelativePath>%(_AppPriForPublish.Filename)%(_AppPriForPublish.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
